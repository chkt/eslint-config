{
	"include" : [
		"./test/**/*.ts"
	],
	"compilerOptions": {
		"baseUrl": ".",
		"outDir": "./dist",

		"target": "es2020",
		"lib": [ "es2022", "dom" ],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"allowImportingTsExtensions": false,

		"newLine": "LF",
		"sourceMap": false,
		"declaration": true,

		"strict": true,
		"exactOptionalPropertyTypes": false,
		"noImplicitReturns": true,
		"noPropertyAccessFromIndexSignature": true,
		"removeComments": false
	},
	"compileOnSave": false
}
